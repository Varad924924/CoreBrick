# PostgreSQL
POSTGRES_DB=corebrick
POSTGRES_USER=corebrick_user
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30

# Optional SMTP settings for architect email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_company_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_EMAIL=your_company_email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
